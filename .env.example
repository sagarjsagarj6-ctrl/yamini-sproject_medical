NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB is required for persistent records. Local development may temporarily
# fall back to in-memory records when MongoDB is unavailable.
MONGODB_URI=mongodb://127.0.0.1:27017/medico

# Generate a unique random value for each deployed environment.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_API_KEY=replace-with-a-separate-long-random-secret

# Optional AI insights provider (leave empty to disable AI generation).
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

# Optional profile image storage. Uploads are disabled unless all values exist.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional; reminder worker defaults to 90 minutes and enforces 15–1440 minutes.
MISSED_DOSE_GRACE_MINUTES=90
